# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000

# Local:  mongodb://127.0.0.1:27017/techfest
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techfest
MONGO_URI=mongodb://127.0.0.1:27017/techfest

# Use a long random value in production, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Frontend address(es) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Set to production on Render (turns on secure cookies, hides error details)
NODE_ENV=development
